<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:mr="clr-namespace:MR.Gestures;assembly=MR.Gestures"
			 x:Class="GestureSample.Views.ShowDataXaml">
    <ContentPage.Resources>
        <Style x:Key="ShowDataPickerStyle" TargetType="Picker">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="#342048" />
            <Setter Property="TitleColor" Value="#8B7D9C" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
        <Style x:Key="ShowDataFilterLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.5" />
            <Setter Property="TextColor" Value="#8A789B" />
        </Style>
    </ContentPage.Resources>
    <Grid>
        <!-- Define Row Definitions -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- For Pickers -->
            <RowDefinition Height="Auto" />
            <!-- For Header Grid -->
            <RowDefinition Height="*" />
            <!-- For CollectionView -->
        </Grid.RowDefinitions>

        <!-- Pickers -->
        <StackLayout x:Name="PickerPanel" Orientation="Vertical" Grid.Row="0" Padding="8,8,8,0" Spacing="6">
            <Border Stroke="#D9CBEA" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="#FFFDFE" Padding="12,7,12,5">
                <VerticalStackLayout Spacing="1">
                    <Label Text="USER" Style="{StaticResource ShowDataFilterLabelStyle}" />
                    <Picker x:Name="UserPicker" Title="Pick a user" ItemsSource="{Binding Users}" SelectedIndexChanged="OnUserPickerSelectedIndexChanged" Style="{StaticResource ShowDataPickerStyle}" />
                </VerticalStackLayout>
            </Border>
            <Border Stroke="#D9CBEA" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="#FFFDFE" Padding="12,7,12,5">
                <VerticalStackLayout Spacing="1">
                    <Label Text="DATE" Style="{StaticResource ShowDataFilterLabelStyle}" />
                    <Picker x:Name="DatePicker" Title="Pick a day" ItemsSource="{Binding GameDates}" SelectedIndexChanged="OnDatePickerSelectedIndexChanged" Style="{StaticResource ShowDataPickerStyle}"/>
                </VerticalStackLayout>
            </Border>
            <Border Stroke="#D9CBEA" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="#FFFDFE" Padding="12,7,12,5">
                <VerticalStackLayout Spacing="1">
                    <Label Text="GAME" Style="{StaticResource ShowDataFilterLabelStyle}" />
                    <Picker x:Name="GamePicker" Title="Pick a session" ItemsSource="{Binding GameIdentifiersFiltered}" SelectedIndexChanged="OnPickerSelectedIndexChanged" Style="{StaticResource ShowDataPickerStyle}"/>
                </VerticalStackLayout>
            </Border>
        </StackLayout>

        <!-- Header Grid -->
        <Grid x:Name="HeaderGrid" Grid.Row="1" ColumnDefinitions="45,90,15,220" Padding="5" BackgroundColor="MediumPurple" HorizontalOptions="FillAndExpand">
            <Label Grid.Column="0" Text="#" FontSize="Large" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Seconds" FontSize="Large" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="3" Text="Question" FontSize="Large" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- CollectionView -->
        <CollectionView x:Name="StateList" Grid.Row="2" Margin="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="Gray" CornerRadius="5" Padding="2" Margin="2" BackgroundColor="{Binding RowBackgroundColor}">
                        <Grid ColumnDefinitions="52,70,33,60,20,60,20,60"
                              RowDefinitions="Auto,Auto,Auto"
                              Padding="2"
                              HorizontalOptions="FillAndExpand">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding QuestionNumber}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                            <Frame Grid.Row="0" Grid.Column="1" BorderColor="Black" CornerRadius="5" Padding="2" BackgroundColor="{Binding TimeColor}">
                                <Label Text="{Binding TimeOnTask, StringFormat='{}{0:0.00 }'}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <Label Grid.Row="0" Grid.Column="2" Text="" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                            <Frame Grid.Row="0" Grid.Column="3" BorderColor="Black" CornerRadius="5" Padding="2" BackgroundColor="{Binding Addend1Color}">
                                <Label Text="{Binding Addend1}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <Label Grid.Row="0" Grid.Column="4" Text="{Binding OpDString}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Frame Grid.Row="0" Grid.Column="5" BorderColor="Black" CornerRadius="5" Padding="2" BackgroundColor="{Binding Addend2Color}">
                                <Label Text="{Binding Addend2}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <Label Grid.Row="0" Grid.Column="6" Text="=" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                            <Frame Grid.Row="0" Grid.Column="7" BorderColor="Black" CornerRadius="5" Padding="2" BackgroundColor="{Binding SumColor}">
                                <Label Text="{Binding Sum}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>

                            <Grid Grid.Row="1"
                                  Grid.Column="3"
                                  Grid.ColumnSpan="5"
                                  ColumnDefinitions="60,20,60,20,60"
                                  Margin="0,6,0,0"
                                  IsVisible="{Binding HasSecondaryPpw}">
                                <Frame Grid.Column="0" BorderColor="Black" CornerRadius="5" Padding="2" BackgroundColor="{Binding SecondaryAddend1BackgroundColor}">
                                    <Label Text="{Binding SecondaryAddend1Text}" TextColor="{Binding SecondaryAddend1TextColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Frame>
                                <Label Grid.Column="1" Text="{Binding OpDString}" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Frame Grid.Column="2" BorderColor="Black" CornerRadius="5" Padding="2" BackgroundColor="{Binding SecondaryAddend2BackgroundColor}">
                                    <Label Text="{Binding SecondaryAddend2Text}" TextColor="{Binding SecondaryAddend2TextColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Frame>
                                <Label Grid.Column="3" Text="=" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                                <Frame Grid.Column="4" BorderColor="Black" CornerRadius="5" Padding="2" BackgroundColor="{Binding SecondarySumBackgroundColor}">
                                    <Label Text="{Binding SecondarySumText}" TextColor="{Binding SecondarySumTextColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Frame>
                            </Grid>

                            <VerticalStackLayout Grid.Row="2"
                                                 Grid.Column="3"
                                                 Grid.ColumnSpan="5"
                                                 Margin="0,6,0,0"
                                                 Spacing="4"
                                                 IsVisible="{Binding HasHelperRows}"
                                                 BindableLayout.ItemsSource="{Binding HelperRows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <HorizontalStackLayout HorizontalOptions="Center"
                                                               Spacing="4"
                                                               BindableLayout.ItemsSource="{Binding Parts}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Frame BorderColor="Black"
                                                           CornerRadius="5"
                                                           Padding="2"
                                                           BackgroundColor="{Binding BackgroundColor}">
                                                        <Label Text="{Binding ValueText}"
                                                               TextColor="{Binding TextColor}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Frame>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
    
</ContentPage>
