<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GestureSample.Maui.Models"
             x:Class="GestureSample.Views.ShowDataXamlKeyboard">
    <ContentPage.Resources>
        <Style x:Key="ShowDataPickerStyle" TargetType="Picker">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="#342048" />
            <Setter Property="TitleColor" Value="#8B7D9C" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
        <Style x:Key="ShowDataFilterLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.5" />
            <Setter Property="TextColor" Value="#8A789B" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout x:Name="PickerPanel" Grid.Row="0" Padding="8,8,8,0" Spacing="6">
            <Border Stroke="#D9CBEA" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="#FFFDFE" Padding="12,7,12,5">
                <VerticalStackLayout Spacing="1">
                    <Label Text="DATE" Style="{StaticResource ShowDataFilterLabelStyle}" />
                    <Picker x:Name="DatePicker"
                            Title="Pick a day"
                            SelectedIndexChanged="OnDatePickerSelectedIndexChanged"
                            Style="{StaticResource ShowDataPickerStyle}" />
                </VerticalStackLayout>
            </Border>
            <Border Stroke="#D9CBEA" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="#FFFDFE" Padding="12,7,12,5">
                <VerticalStackLayout Spacing="4">
                    <Label Text="GAME" Style="{StaticResource ShowDataFilterLabelStyle}" />
                    <Picker x:Name="GamePicker"
                            Title="Pick a session"
                            SelectedIndexChanged="OnPickerSelectedIndexChanged"
                            Style="{StaticResource ShowDataPickerStyle}"
                            HorizontalOptions="FillAndExpand" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <CollectionView x:Name="Questions"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureAllItems"
                        VerticalScrollBarVisibility="Always"
                        ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="4" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="LightGray"
                           CornerRadius="8"
                           Padding="10"
                           Margin="10,6"
                           BackgroundColor="{Binding Question.RowBackgroundColor}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding Question.QuestionNumber}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <BoxView Grid.Column="1"
                                         WidthRequest="12"
                                         HeightRequest="12"
                                         CornerRadius="6"
                                         Color="{Binding Question.ResultLightColor}"
                                         VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding Question.ResultStatusText}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       LineBreakMode="NoWrap" />
                                <Button Grid.Column="3"
                                        Text="Replay"
                                        Clicked="OnReplayClicked"
                                        IsEnabled="{Binding HasReplay}" />
                                <Button Grid.Column="4"
                                        Text="Replay All"
                                        Clicked="OnReplayAllClicked"
                                        IsVisible="{Binding HasCombinedReplay}"
                                        IsEnabled="{Binding HasCombinedReplay}" />
                            </Grid>

                            <Label Text="{Binding Question.AttemptText}"
                                   FontSize="12"
                                   TextColor="DimGray"
                                   LineBreakMode="NoWrap" />

                            <Label Text="{Binding Question.TutorialStatusText}"
                                   FontSize="12"
                                   TextColor="DarkOrange"
                                   FontAttributes="Bold"
                                   LineBreakMode="NoWrap"
                                   IsVisible="{Binding Question.WasTutorialUsed}" />

                            <Label Text="{Binding Question.QuestionCodeText}"
                                   FontSize="12"
                                   TextColor="DimGray"
                                   LineBreakMode="WordWrap" />

                            <HorizontalStackLayout Spacing="8"
                                                   IsVisible="{Binding Question.HasPromptText}">
                                <Label Text="Q"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding Question.QuestionPromptText}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       LineBreakMode="NoWrap" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding TimingSummaryText}"
                                   FontSize="12"
                                   TextColor="DimGray"
                                   LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasTimingSummary}" />

                            <VerticalStackLayout Spacing="4"
                                                 IsVisible="{Binding Question.ShowCombinedArrowKeyboard}">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Question.CombinedArrowKeyboardLabel}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Question.SubmittedTimeText}"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           FontSize="12"
                                           IsVisible="{Binding Question.HasSubmittedKeyboard}" />
                                </Grid>
                                <local:KeyboardSnapshotView KeyColors="{Binding Question.CombinedArrowKeyboardColors}"
                                                           KeysInRow="{Binding Question.KeyboardKeysInRow}"
                                                           Rows="{Binding Question.KeyboardRows}"
                                                           Weights="{Binding Question.KeyboardWeights}"
                                                           AboveNumber="{Binding Question.aboveNumber}"
                                                           ArrowLength="{Binding Question.length}"
                                                           Direction="{Binding Question.dir}"
                                                           InputTransparent="True"
                                                           HorizontalOptions="Fill" />
                                <Label Text="{Binding Question.CombinedArrowLegendText}"
                                       FontSize="11"
                                       TextColor="DimGray"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Spacing="8"
                                                   IsVisible="{Binding Question.ShowPrimaryQuestionKeyboard}">
                                <Label Text="Q"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       VerticalOptions="Center" />
                                <local:KeyboardSnapshotView Keys="{Binding Question.keyboard1}"
                                                           KeysInRow="{Binding Question.KeyboardKeysInRow}"
                                                           Rows="{Binding Question.KeyboardRows}"
                                                           Weights="{Binding Question.KeyboardWeights}"
                                                           AboveNumber="{Binding Question.aboveNumber}"
                                                           ArrowLength="{Binding Question.length}"
                                                           Direction="{Binding Question.dir}"
                                                           Compact="True"
                                                           InputTransparent="True" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="8"
                                                   IsVisible="{Binding Question.ShowInitialKeyboardPreview}">
                                <Label Text="Init"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       VerticalOptions="Center" />
                                <local:KeyboardSnapshotView Keys="{Binding Question.InitialKeyboardState}"
                                                           KeysInRow="{Binding Question.KeyboardKeysInRow}"
                                                           Rows="{Binding Question.KeyboardRows}"
                                                           Weights="{Binding Question.KeyboardWeights}"
                                                           Compact="True"
                                                           InputTransparent="True" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="8"
                                                   IsVisible="{Binding Question.HasVisibleSecondQuestionKeyboard}">
                                <Label Text="Q2"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       VerticalOptions="Center" />
                                <local:KeyboardSnapshotView Keys="{Binding Question.keyboard2}"
                                                           KeysInRow="{Binding Question.KeyboardKeysInRow}"
                                                           Rows="{Binding Question.KeyboardRows}"
                                                           Weights="{Binding Question.KeyboardWeights}"
                                                           InputTransparent="True" />
                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="6"
                                                 IsVisible="{Binding Question.ShowSeparateSubmittedKeyboard}">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="A"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Question.SubmittedTimeText}"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           FontSize="12"
                                           LineBreakMode="NoWrap" />
                                </Grid>
                                <local:KeyboardSnapshotView Keys="{Binding Question.SubmittedKeyboard}"
                                                           KeysInRow="{Binding Question.KeyboardKeysInRow}"
                                                           Rows="{Binding Question.KeyboardRows}"
                                                           Weights="{Binding Question.KeyboardWeights}"
                                                           Compact="False"
                                                           InputTransparent="True"
                                                           HorizontalOptions="Fill" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
