<?xml version="1.0" encoding="utf-8" ?>
    
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
				xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
				xmlns:mr="clr-namespace:MR.Gestures;assembly=MR.Gestures"
				x:Class="GestureSample.Views.RecordsUser">
    <Grid Padding="0,12,0,0">
        <!-- Define Row Definitions -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- For Pickers -->
            <RowDefinition Height="Auto" />
            <!-- For Header Grid -->
            <RowDefinition Height="*" />
            <!-- For CollectionView -->
        </Grid.RowDefinitions>

        <!-- Pickers -->
        <StackLayout Orientation="Vertical" Grid.Row="0" Padding="10,14,10,0">
            <Picker x:Name="GamePicker" Title="Select a Game" ItemsSource="{Binding GameIdentifiers}" SelectedIndexChanged="OnPickerSelectedIndexChanged" FontFamily="Courier New"/>
        </StackLayout>

        <!-- Header Grid -->
        <Grid Grid.Row="1" ColumnDefinitions="90,90,70,70" Padding="5" Margin="0,6,0,0" BackgroundColor="MediumPurple" HorizontalOptions="FillAndExpand">
            <Label Grid.Column="0" Text="" FontSize="Large" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Time" FontSize="Large" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="wins" FontSize="Large" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="3" Text="loses" FontSize="Large" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- CollectionView -->
        <CollectionView x:Name="StateList" Grid.Row="2" Margin="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="Gray" CornerRadius="5" Padding="2" Margin="2" >
                        <Grid ColumnDefinitions="90,90,70,70" Padding="2" HorizontalOptions="FillAndExpand">
                            <Label Grid.Column="0" Text="{Binding TimeStart}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                            <Label Grid.Column="1"  Text="{Binding FinalTime, StringFormat='{}{0:mm\\:ss\\.ff}'}" HorizontalOptions="Center" VerticalOptions="Center" />
                            
                            <!-- Additional Columns -->
                            <Label Grid.Column="2" Text="{Binding Wins}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="3" Text="{Binding Losses}" HorizontalOptions="Center" VerticalOptions="Center" />
                            
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </Grid>
    
</ContentPage>
