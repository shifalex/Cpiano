<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GestureSample.Maui.Views.CreateUserPage"
    Title="Create New User">
    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="Create New User" FontSize="Large" HorizontalOptions="Center" />
        <Entry x:Name="UserNameEntry" Placeholder="Enter user name here" />

        <!-- If you have avatars or images, present them here -->
        <Image x:Name="SelectedAvatarImage" WidthRequest="100" HeightRequest="100" 
               HorizontalOptions="Center" VerticalOptions="Center" />
        <Button Text="Pick Avatar (Not implemented)" />

        <Button Text="Create" Clicked="OnCreateButtonClicked" />
    </VerticalStackLayout>
</ContentPage>