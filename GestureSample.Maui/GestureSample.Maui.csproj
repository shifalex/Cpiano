<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-ios;net8.0-android</TargetFrameworks>

		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">
			$(TargetFrameworks);net8.0-windows10.0.19041.0
		</TargetFrameworks>

		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">
			$(TargetFrameworks);net8.0-maccatalyst
		</TargetFrameworks>

		<Platforms>AnyCPU;ARM64</Platforms>
	</PropertyGroup>

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>GestureSample.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>annotations</Nullable>

		<ApplicationTitle>Cpiano</ApplicationTitle>
		<ApplicationId>com.companyname.gesturesample.maui</ApplicationId>
		<ApplicationIdGuid>e9e0a3cc-b04c-490d-a506-479ce5920e60</ApplicationIdGuid>

		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>

		<AssemblyName>GestureSample</AssemblyName>
	</PropertyGroup>

	<UsingTask TaskName="RoslynCodeTaskFactory"
			   AssemblyFile="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v16.0\CodeTaskFactory\Microsoft.Build.Tasks.CodeTaskFactory.dll" />

	<!-- iOS development signing -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-ios'">
		<ProvisioningType>automatic</ProvisioningType>
		<CodesignKey>Apple Development: Created via API (8LC2PPNR53)</CodesignKey>
		<CodesignProvision>VS: com.companyname.gesturesample.maui Development</CodesignProvision>

		<!-- Do not generate an IPA locally -->
		<BuildIpa>false</BuildIpa>
		<ArchiveOnBuild>false</ArchiveOnBuild>
	</PropertyGroup>

	<!-- iOS Debug -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' And '$(TargetFramework)' == 'net8.0-ios'">
		<MtouchDebug>true</MtouchDebug>
		<EnableSGenConc>true</EnableSGenConc>
	</PropertyGroup>

	<!-- iOS Release -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(TargetFramework)' == 'net8.0-ios'">
		<MtouchDebug>false</MtouchDebug>
		<EnableSGenConc>true</EnableSGenConc>
		<MtouchLink>Full</MtouchLink>
		<IpaIncludeArtwork>true</IpaIncludeArtwork>
	</PropertyGroup>

	<!-- Android -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<TargetSdkVersion>34</TargetSdkVersion>
		<MinSdkVersion>21</MinSdkVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
	</ItemGroup>

	<!-- MAUI Resources -->
	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg"
				  ForegroundFile="Resources\AppIcon\appiconfg.svg"
				  Color="#3167E3" />

		<MauiSplashScreen Include="Resources\Splash\splash.svg"
						  Color="#F7F8FC"
						  BaseSize="160,160" />

		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.svg"
				   BaseSize="168,208" />

		<MauiFont Include="Resources\Fonts\*" />

		<MauiAsset Include="Resources\Raw\**"
				   LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup Condition="Exists('supabase.local.json')">
		<EmbeddedResource Include="supabase.local.json"
						  LogicalName="supabase.local.json" />
	</ItemGroup>

	<!-- Excluded source files -->
	<ItemGroup>
		<Compile Remove="Tools\**\*.cs" />
		<Compile Remove="Models\configLoader.cs" />
		<Compile Remove="Views\SplashPagecs.xaml.cs" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Remove="Views\SplashPagecs.xaml" />
	</ItemGroup>

	<!-- Packages -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Enums.NET" Version="5.0.0" />
		<PackageReference Include="MongoDB.Bson" Version="2.26.0" />
		<PackageReference Include="MongoDB.Driver" Version="2.26.0" />
		<PackageReference Include="MR.Gestures" Version="5.0.0" />
		<PackageReference Include="MvvmCross" Version="10.1.2" />
		<PackageReference Include="Plugin.Maui.Audio" Version="3.1.1" />
		<PackageReference Include="SkiaSharp" Version="3.119.1" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.1" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="Supabase" Version="1.1.1" />
	</ItemGroup>

	<!-- XAML configuration -->
	<ItemGroup>
		<Compile Update="Views\RecordsUser.xaml.cs">
			<DependentUpon>RecordsUser.xaml</DependentUpon>
		</Compile>
		<Compile Update="Views\ShowDataXamlKeyboard.xaml.cs">
			<DependentUpon>ShowDataXamlKeyboard.xaml</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Views\CreateUserPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\NewPage1.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\RecordsUser.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\ShowDataXamlKeyboard.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\SplashPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\SwitchUserPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Update="Microsoft.Extensions.DependencyInjection"
						  Version="8.0.0" />
	</ItemGroup>

	<!-- Optional local-only settings -->
	<Import Project="Local.Build.props"
			Condition="Exists('Local.Build.props')" />

</Project>
